# ============================================
# PENSADERO - FRONTEND (modo DESARROLLO)
# ============================================
# Vite carga este archivo SOLO en `npm run dev` (frontend en :5173, backend en
# :5000 -> distinto origen). Por eso hay que apuntar explicitamente al backend.
#
# En produccion NO se usa: el backend sirve el bundle en el mismo origen y el
# frontend usa URLs relativas (ver .env.production y src/config/index.ts).

VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws
