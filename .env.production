# ============================================
# PENSADERO - FRONTEND (modo PRODUCCION)
# ============================================
# Vite carga este archivo en `npm run build`. Dejamos las URLs VACIAS a
# proposito: el backend sirve el bundle en el MISMO origen que la API, asi que
# el frontend usa rutas relativas y funciona desde cualquier host (localhost,
# pensadero, IP de LAN/VPN) sin reconstruir.
#
# NO pongas aqui http://localhost:5000 o romperas el acceso remoto: el build
# quedaria atado a "localhost" y fallaria desde otros dispositivos.

VITE_API_URL=
VITE_WS_URL=
