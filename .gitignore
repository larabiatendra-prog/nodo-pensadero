tools/node/

# Python venv y caches del módulo de reconocimiento facial
backend/python/.venv/
backend/python/__pycache__/
backend/python/*.pyc

# Datos persistentes del backend (no versionar)
backend/thumbnails/
backend/media_cache.json
backend/media_cache_backup_*.json
backend/favorites_persistent.json
backend/collections_persistent.json
backend/notes_persistent.json
backend/scan_paths.json
backend/embeddings_index.json
backend/visual_search_data/
backend/clip_index.json
backend/video_proxies.json
# Preferencias que el usuario cambia desde la UI (modelo VLM activo, etc.).
# Son estado de esta maquina, no configuracion del proyecto.
backend/config/runtime.json
backend/proxies/
backend/temp/
backend/reports/
# Datos del registry de personas (fotos personales, identidades)
backend/data/

# Backup estatico local de los archivos clave (copias de consulta, no codigo
# activo). Se refresca a mano desde backend/ y src/; NO se versiona.
Archivos más importantes/
# Carpeta de contexto para iterar en ChatGPT (copia plana refrescable). Local.
contexto-chatgpt/

# Artefactos de workflows de auditoria (reportes/hallazgos generados). Local.
.audit-findings.json
.audit-report.md
.audit-workflow.js

# Subproductos de escritura atomica / cuarentena de jsonStore (regenerables):
#  - <fichero>.<pid>.<seq>.tmp  (temporal de tmp+rename)
#  - <fichero>.bak              (red de seguridad de la version previa)
#  - <fichero>.corrupt-<ts>     (JSON ilegible puesto en cuarentena)
# No versionar nunca; un crash a media escritura puede dejarlos sueltos.
*.tmp
*.bak
*.corrupt-*

# Patrones genericos heredados
embeddings_index.json
media_cache.json
vector_index.json
**/thumbnails/
**/temp/
**/training_data/
media_cache_backup*

# Carpeta tecnica por-biblioteca: cachés regenerables (thumbnails) que viven
# junto a cada disco escaneado (<scanRoot>\.pensadero). No versionar.
**/.pensadero/
