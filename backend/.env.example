# ============================================
# PENSADERO - Configuración de entorno
# ============================================
# Copia este archivo como `.env` y ajusta los valores a tu máquina.
# `.env` NO debe subirse a control de versiones.

# Puerto en el que escucha el servidor (frontend + API + WebSocket)
PORT=5000

# Interfaz de escucha:
#   - 127.0.0.1  -> solo este PC (default, sin exposición a red)
#   - 0.0.0.0    -> accesible en LAN/VPN. La app NO tiene auth: hazlo solo en
#                   red de confianza o detrás de una VPN.
HOST=127.0.0.1

# Directorio raíz por defecto si scan_paths.json está vacío.
# Déjalo vacío en distribución; añade rutas desde la UI cuando arranques.
# Ejemplo Windows: C:\TOOLS\Pensadero\biblioteca
# Ejemplo Linux/Mac: /home/user/Pensadero
CONTENT_DIR=

# (Legacy) URL pública del servidor. Ya NO se usa para las URLs de thumbnails
# ni streaming: ahora son relativas al origen (ver src/config/index.ts). Se
# conserva por compatibilidad; puedes ignorarla.
SERVER_URL=http://localhost:5000

# Host de Ollama (búsqueda en lenguaje natural y escaneo visual)
OLLAMA_HOST=http://localhost:11434

# Modelo Ollama para la BUSQUEDA en lenguaje natural. Solo interpreta intención
# -> JSON estructurado, expande sinónimos y resuelve personas/espacios/conceptos.
# El filtrado y el ranking son deterministas y locales (no los hace el LLM).
#   - qwen2.5:7b-instruct   → rápido, ~5 GB VRAM (objetivo NODO: velocidad)
#   - qwen2.5:14b-instruct  → más calidad, ~9 GB VRAM
# Descargar con: ollama pull <modelo>
# Pensadero arranca y funciona sin Ollama; sólo cae el modo "Natural".
OLLAMA_MODEL=qwen2.5:14b-instruct

# Modelo VLM (Visión + Lenguaje) para describir imágenes/vídeo durante el escaneo.
# Genera el _pensadero.json por carpeta con description, composition, tags,
# OCR, etc. NO hay fallback automático: hay UN solo VLM_MODEL. Si falla o no
# rinde, cámbialo a mano y re-escanea.
# Catalogo curado (aparece siempre en el selector de la UI; los no instalados
# se marcan "pendiente de descarga"):
#   - gemma4:12b     → produccion, default NODO. Equilibrio calidad/velocidad/VRAM.
#   - gemma4:27b     → experimento. Mayor calidad, mas coste. Riesgo OOM en 16 GB.
#   - gemma3:12b     → legacy/fallback manual (~8 GB VRAM).
# Otros VLM instalados en Ollama (qwen2.5vl:7b, llava...) tambien salen en el selector.
# Descargar con: ollama pull <modelo>
# Para NODO usa backend/.env.nodo como punto de partida.
VLM_MODEL=gemma4:12b

# Parámetros del escaneo visual. Defaults razonables; tocar solo con criterio.
# VLM_VIDEO_FRAMES: frames muestreados por vídeo (inicio/medio/final). El vídeo
#   se trata como una ESCENA ÚNICA. No hay lógica adaptativa por duración ni
#   detección de escenas. Mantener en 3.
VLM_VIDEO_FRAMES=3
# VLM_TIMEOUT_MS: timeout por imagen (ms). Sube a 300000 con modelos grandes
#   (p.ej. gemma3:12b) por el cold-start de la primera llamada.
VLM_TIMEOUT_MS=180000
# VLM_VIDEO_NUM_PREDICT: tokens de la llamada multi-imagen de vídeo.
VLM_VIDEO_NUM_PREDICT=1400
# VLM_IMAGE_MAX_SIDE: lado mayor (px) al redimensionar antes de pasar al VLM.
VLM_IMAGE_MAX_SIDE=1568

# Stage 2 re-ranking — usa el LLM como reranker semántico cuando Stage 1
# (matching literal) devuelve pocos resultados claros. Resuelve queries
# abstractas tipo "edificios" o "imagen exterior" donde la palabra no
# aparece literal en la metadata.
AI_RERANK_ENABLED=true
AI_RERANK_MIN_PRIMARY=5

# Proveedor de ejecución para InsightFace (detección facial).
# Valores: "gpu" (default) → CUDA con fallback automático a CPU
#          "cpu" → fuerza CPU; libera VRAM para el VLM (útil en máquinas con <12 GB VRAM)
# En NODO (RTX 5070 Ti, 16 GB) no hace falta definir esta variable.
FACE_PROVIDER=

# Registry de personas. Si están vacíos, se usan defaults dentro de
# backend/data/ y se crean automáticamente al guardar la primera persona
# desde la UI ("Personas" en el menú).
PERSONS_REGISTRY=
PERSONS_AVATARS_BASE=
