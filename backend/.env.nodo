# ==================================================================
# PENSADERO - Configuracion OBJETIVO para NODO (no para el Dell de dev)
# ==================================================================
# Hardware objetivo: RTX 5070 Ti 16 GB, 64 GB RAM, NVMe local, archivo
# audiovisual en disco externo. Uso local-first, sin internet en operacion.
#
# USO EN NODO: copia este archivo como `.env` dentro de backend/:
#     copy backend\.env.nodo backend\.env
#
# MODELOS REQUERIDOS en Ollama. Pensadero_Install.bat ya los descarga en el
# paso 9; estos comandos solo hacen falta si bajas alguno a mano:
#     ollama pull internvl3:14b          (VLM principal de escaneo)
#     ollama pull qwen2.5:7b-instruct    (busqueda en lenguaje natural)
#     ollama pull qwen2.5vl:7b           (VLM fallback MANUAL, opcional)
#
# IMPORTANTE: NO hay fallback automatico de VLM. Hay UN solo VLM_MODEL. Si
# internvl3:14b falla o no rinde bien en NODO, cambia VLM_MODEL a qwen2.5vl:7b
# A MANO aqui y re-escanea. No existe (ni se quiere) logica de fallback dinamico.

PORT=5000
SERVER_URL=http://localhost:5000

# Directorio raiz por defecto si scan_paths.json esta vacio. Dejar vacio:
# las rutas (discos externos) se anaden desde la UI -> Rutas.
CONTENT_DIR=

OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------
# Escaneo visual  -  PRIORIDAD: calidad de metadata, NO velocidad.
# El escaneo puede durar horas o dias. Es aceptable.
# ------------------------------------------------------------------
# VLM principal. Fallback manual: qwen2.5vl:7b (cambiar a mano, sin automatismo).
VLM_MODEL=internvl3:14b

# Timeout por imagen (ms). Holgado a proposito por el cold-start del modelo 14b
# (la primera llamada carga ~9-10 GB y puede tardar).
VLM_TIMEOUT_MS=300000

# Vídeo = una unica escena curada: 3 frames (inicio / medio / final). El VLM lo
# interpreta como secuencia temporal unica. NO subir a 5-6, NO logica adaptativa
# por duracion, NO deteccion algoritmica de escenas.
VLM_VIDEO_FRAMES=3

# Tokens de la llamada multi-imagen de vídeo (descripcion temporal completa).
VLM_VIDEO_NUM_PREDICT=1400

# Lado mayor (px) al redimensionar la imagen antes de mandarla al VLM.
VLM_IMAGE_MAX_SIDE=1568

# ------------------------------------------------------------------
# Busqueda en lenguaje natural  -  PRIORIDAD: velocidad percibida.
# El modelo de texto solo interpreta intencion -> JSON estructurado, expande
# sinonimos y resuelve personas/espacios/conceptos. El filtrado y el ranking
# siguen siendo DETERMINISTAS y locales (no los hace el LLM).
# ------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:7b-instruct
AI_RERANK_ENABLED=true
AI_RERANK_MIN_PRIMARY=5

# ------------------------------------------------------------------
# Caras (InsightFace) y proveedor de ejecucion.
# Vacio = "gpu" (CUDA con fallback automatico a CPU). En 16 GB no hace falta
# forzar nada; si el VLM 14b deja poca VRAM y ves OOM en caras, pon FACE_PROVIDER=cpu.
# ------------------------------------------------------------------
FACE_PROVIDER=

# Registry de personas. Vacios = defaults dentro de backend/data/ (se crean solos).
PERSONS_REGISTRY=
PERSONS_AVATARS_BASE=
